# Rust
/target
**/*.rs.bk

# Node / frontend
node_modules/
ui/dist/
ui/node_modules/

# Tauri build output
src-tauri/target/
src-tauri/gen/

# Models (downloaded separately — multi-GB, not committed)
*.gguf
*.bin

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Secrets — never commit. API keys live in the OS keychain, never in files.
.env
.env.*
*.pem

# Eval recordings are your voice, and eval reports contain transcripts of what you dictated:
# keep both local. The manifest and the recording script are tracked.
eval/fixtures/*.wav
eval/fixtures/*.aiff
eval/fixtures/*.m4a
eval/fixtures/*.mp3
eval/fixtures/*.flac
eval/reports/

